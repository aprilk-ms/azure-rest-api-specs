{
  "title": "Reconcile an unchanged EvalSuite without creating another version",
  "operationId": "EvalSuites_reconcile",
  "parameters": {
    "api-version": "2025-11-15-preview",
    "Foundry-Features": "Evaluations=V1Preview",
    "name": "claims-regression",
    "body": {
      "harness_task_set": {
        "name": "claims-regression",
        "version": "1"
      },
      "harness_config": {
        "type": "inline_foundry_agent_harness",
        "agent": {
          "name": "claims-agent",
          "version": "7"
        }
      },
      "execution_config": {
        "type": "harness_invocation"
      },
      "graders": [
        {
          "name": "policy_citation",
